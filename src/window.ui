<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="NowdothisWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Now Do This</property>
    <property name="default-width">600</property>
    <property name="default-height">480</property>
    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="AdwNavigationView" id="navigation_view">

            <!-- Doing: the only thing on screen is the task at hand. Declared
                 first, so it is the root of the navigation stack. -->
            <child>
              <object class="AdwNavigationPage" id="focus_page">
                <property name="title" translatable="yes">Now Do This</property>
                <property name="tag">focus</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <property name="show-title">False</property>
                        <child type="start">
                          <object class="GtkMenuButton">
                            <property name="primary">True</property>
                            <property name="icon-name">open-menu-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Main Menu</property>
                            <property name="menu-model">primary_menu</property>
                          </object>
                        </child>
                        <child type="end">
                          <object class="GtkButton" id="edit_button">
                            <property name="child">
                              <object class="AdwButtonContent">
                                <property name="icon-name">document-edit-symbolic</property>
                                <property name="label" translatable="yes">Edit List</property>
                              </object>
                            </property>
                            <style>
                              <class name="flat"/>
                            </style>
                          </object>
                        </child>
                        <child type="end">
                          <object class="GtkButton" id="add_button">
                            <property name="icon-name">list-add-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Add Task</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <property name="content">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="vexpand">True</property>
                        <property name="child">
                          <object class="AdwClamp">
                            <property name="maximum-size">480</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="valign">center</property>
                                <property name="spacing">40</property>
                                <property name="margin-top">24</property>
                                <property name="margin-bottom">24</property>
                                <property name="margin-start">24</property>
                                <property name="margin-end">24</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">8</property>
                                    <child>
                                      <!-- The constant half of the sentence the
                                           app says; the task below is the part
                                           that changes. -->
                                      <object class="GtkRevealer" id="prompt_revealer">
                                        <property name="transition-type">crossfade</property>
                                        <property name="transition-duration">250</property>
                                        <property name="child">
                                          <object class="GtkLabel">
                                            <property name="label" translatable="yes">Now do this</property>
                                            <property name="justify">center</property>
                                            <style>
                                              <class name="dim-label"/>
                                              <class name="task-list"/>
                                            </style>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                    <child>
                                  <!-- Completing a task advances the list, so
                                       the next one rises into the place the
                                       last one left, the way it sits one line
                                       below in the editor. -->
                                  <object class="GtkStack" id="task_stack">
                                    <property name="transition-type">slide-up</property>
                                    <property name="transition-duration">250</property>
                                    <property name="interpolate-size">True</property>
                                    <property name="vhomogeneous">False</property>
                                    <child>
                                      <object class="GtkStackPage">
                                        <property name="name">a</property>
                                        <property name="child">
                                          <object class="GtkLabel" id="task_label_a">
                                            <property name="wrap">True</property>
                                            <property name="wrap-mode">word-char</property>
                                            <property name="justify">center</property>
                                            <style>
                                              <class name="task"/>
                                            </style>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkStackPage">
                                        <property name="name">b</property>
                                        <property name="child">
                                          <object class="GtkLabel" id="task_label_b">
                                            <property name="wrap">True</property>
                                            <property name="wrap-mode">word-char</property>
                                            <property name="justify">center</property>
                                            <style>
                                              <class name="task"/>
                                            </style>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkStackPage">
                                        <property name="name">done</property>
                                        <property name="child">
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">20</property>
                                            <child>
                                              <object class="GtkImage">
                                                <property name="icon-name">object-select-symbolic</property>
                                                <property name="pixel-size">72</property>
                                                <property name="accessible-role">presentation</property>
                                                <style>
                                                  <class name="success"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkBox">
                                                <property name="orientation">vertical</property>
                                                <property name="spacing">8</property>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="label" translatable="yes">All done</property>
                                                    <property name="wrap">True</property>
                                                    <property name="justify">center</property>
                                                    <style>
                                                      <class name="task"/>
                                                    </style>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Time to relax</property>
                                                    <property name="wrap">True</property>
                                                    <property name="justify">center</property>
                                                    <style>
                                                      <class name="dim-label"/>
                                                      <class name="task-list"/>
                                                    </style>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <!-- The buttons stay put: only the words
                                       travel, so nothing moves out from under
                                       the pointer mid-click. -->
                                  <object class="GtkStack" id="action_stack">
                                    <property name="halign">center</property>
                                    <property name="transition-type">crossfade</property>
                                    <property name="transition-duration">250</property>
                                    <property name="hhomogeneous">False</property>
                                    <property name="vhomogeneous">False</property>
                                    <child>
                                      <object class="GtkStackPage">
                                        <property name="name">task</property>
                                        <property name="child">
                                          <object class="GtkButton" id="done_button">
                                            <property name="label" translatable="yes">Done</property>
                                            <property name="halign">center</property>
                                            <!-- About half the task column: enough
                                                 presence for the one action on the
                                                 screen, without becoming a bar that
                                                 competes with the task itself. -->
                                            <property name="width-request">240</property>
                                            <style>
                                              <class name="pill"/>
                                              <class name="suggested-action"/>
                                              <class name="task-done"/>
                                            </style>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkStackPage">
                                        <property name="name">done</property>
                                        <property name="child">
                                          <object class="GtkBox">
                                            <property name="halign">center</property>
                                            <property name="spacing">12</property>
                                            <child>
                                              <object class="GtkButton" id="plan_button">
                                                <property name="label" translatable="yes">Plan More</property>
                                                <style>
                                                  <class name="pill"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkButton">
                                                <property name="label" translatable="yes">Done for Today</property>
                                                <property name="action-name">app.quit</property>
                                                <style>
                                                  <class name="pill"/>
                                                  <class name="suggested-action"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>

            <!-- Planning: the whole list as free text, one task per line. -->
            <child>
              <object class="AdwNavigationPage" id="plan_page">
                <property name="title" translatable="yes">Today</property>
                <property name="tag">plan</property>
                <!-- Leaving this page is "Start", not "back": the button below
                     is the only way forward. -->
                <property name="can-pop">False</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <child type="start">
                          <object class="GtkMenuButton">
                            <property name="primary">True</property>
                            <property name="icon-name">open-menu-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Main Menu</property>
                            <property name="menu-model">primary_menu</property>
                          </object>
                        </child>
                        <child type="end">
                          <object class="GtkButton" id="start_button">
                            <property name="child">
                              <object class="AdwButtonContent">
                                <property name="icon-name">media-playback-start-symbolic</property>
                                <property name="label" translatable="yes">Start</property>
                              </object>
                            </property>
                            <style>
                              <class name="suggested-action"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <property name="content">
                      <object class="GtkScrolledWindow">
                        <property name="vexpand">True</property>
                        <property name="child">
                          <!-- A document surface, like a text editor: the view
                               fills the window, so there is no background left
                               for it to blend into. -->
                          <object class="GtkOverlay">
                            <property name="vexpand">True</property>
                            <property name="child">
                                  <object class="GtkTextView" id="task_view">
                                    <property name="wrap-mode">word-char</property>
                                    <!-- Wide gaps between tasks, none between
                                         the wrapped lines of one task, so where
                                         a task ends is never in doubt. -->
                                    <property name="pixels-above-lines">7</property>
                                    <property name="pixels-below-lines">7</property>
                                    <property name="pixels-inside-wrap">0</property>
                                    <!-- Hanging indent: a continuation line sits
                                         further right than the line that starts
                                         a task. -->
                                    <property name="indent">-20</property>
                                    <property name="top-margin">28</property>
                                    <property name="bottom-margin">28</property>
                                    <property name="left-margin">48</property>
                                    <property name="right-margin">28</property>
                                    <style>
                                      <class name="task-list"/>
                                    </style>
                                    <property name="accepts-tab">False</property>
                                    <property name="accessible-role">text-box</property>
                                    <accessibility>
                                      <property name="label" translatable="yes">Task list, one task per line</property>
                                    </accessibility>
                                  </object>
                                </property>
                                <child type="overlay">
                                  <object class="GtkLabel" id="placeholder">
                                    <property name="accessible-role">presentation</property>
                                    <property name="can-target">False</property>
                                    <property name="halign">start</property>
                                    <property name="valign">start</property>
                                    <property name="wrap">True</property>
                                    <property name="wrap-mode">word-char</property>
                                    <property name="xalign">0</property>
                                    <property name="margin-top">33</property>
                                    <property name="margin-start">50</property>
                                    <property name="margin-end">28</property>
                                    <property name="label" translatable="yes">What are you doing today? One per line.</property>
                                    <style>
                                      <class name="dim-label"/>
                                      <class name="task-list"/>
                                    </style>
                                  </object>
                                </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>

          </object>
        </property>
      </object>
    </property>
  </template>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Now Do This</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>
