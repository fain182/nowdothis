#: data/camp.pietro.NowDoThis.gschema.xml
msgid "Telegram bot token"
msgstr "Token del bot Telegram"

#: data/camp.pietro.NowDoThis.gschema.xml
msgid ""
"The token BotFather gave for the bot that tasks are sent to. Empty when "
"Telegram is not set up."
msgstr ""
"Il token che BotFather ha dato per il bot a cui si mandano i task. Vuoto se "
"Telegram non è configurato."

#: data/camp.pietro.NowDoThis.gschema.xml
msgid "Telegram bot username"
msgstr "Nome utente del bot Telegram"

#: data/camp.pietro.NowDoThis.gschema.xml
msgid "The username of the bot, without the @, for linking to its chat."
msgstr "Il nome utente del bot, senza la @, per aprire la sua chat."

#: data/camp.pietro.NowDoThis.gschema.xml
msgid "Telegram chat"
msgstr "Chat Telegram"

#: data/camp.pietro.NowDoThis.gschema.xml
msgid ""
"The one chat whose messages are added to the list. Zero until someone first "
"writes to the bot."
msgstr ""
"L'unica chat i cui messaggi vengono aggiunti alla lista. Zero finché "
"qualcuno non scrive al bot."

#: data/camp.pietro.NowDoThis.gschema.xml
msgid "Pinned list message"
msgstr "Messaggio fissato con la lista"

#: data/camp.pietro.NowDoThis.gschema.xml
msgid ""
"The message in the chat that shows the list. Zero until it has been sent."
msgstr ""
"Il messaggio nella chat che mostra la lista. Zero finché non è stato inviato."

#: data/camp.pietro.NowDoThis.gschema.xml
msgid "Next Telegram update"
msgstr "Prossimo aggiornamento Telegram"

#: data/camp.pietro.NowDoThis.gschema.xml
msgid ""
"The first update not yet read, so a restart does not add the same tasks "
"twice."
msgstr ""
"Il primo aggiornamento non ancora letto, così un riavvio non aggiunge due "
"volte gli stessi task."

#: src/window.ui
msgid "Add From _Phone…"
msgstr "Aggiungi dal _telefono…"

#: src/window.rs
msgid "Added from Telegram"
msgstr "Aggiunto da Telegram"

#: src/services/telegram_link.rs
msgid "Today's List"
msgstr "La lista di oggi"

#: src/services/telegram_link.rs
msgid "Welcome to Now Do This"
msgstr "Benvenuto in Now Do This"

#: src/services/telegram_link.rs
msgid ""
"Send me anything you need to do, one task per line, and it goes to the end "
"of your list."
msgstr ""
"Scrivimi le cose da fare, una per riga, e finiscono in fondo alla tua lista."

#: src/services/telegram_link.rs
msgid "Your list stays pinned at the top of this chat."
msgstr "La tua lista resta fissata in cima a questa chat."

#: src/services/telegram_link.rs
msgid "A thumbs up means it arrived."
msgstr "Un pollice in su vuol dire che è arrivato."

#: src/telegram_dialog.rs
msgid "Telegram"
msgstr "Telegram"

#: src/telegram_dialog.rs
msgid "Add Tasks From Your Phone"
msgstr "Aggiungi task dal telefono"

#: src/telegram_dialog.rs
msgid "Get Started"
msgstr "Inizia"

#: src/telegram_dialog.rs
msgid "Create a Bot"
msgstr "Crea un bot"

#: src/telegram_dialog.rs
msgid "Paste the token it gives you"
msgstr "Incolla il token che ti dà"

#: src/telegram_dialog.rs
msgid "Token"
msgstr "Token"

#: src/telegram_dialog.rs
msgid "Telegram did not accept this token"
msgstr "Telegram non ha accettato questo token"

#: src/telegram_dialog.rs
msgid "Continue"
msgstr "Continua"

#: src/telegram_dialog.rs
msgid "Could not reach Telegram. Check your connection."
msgstr "Impossibile raggiungere Telegram. Controlla la connessione."

#: src/telegram_dialog.rs
msgid "Open Chat"
msgstr "Apri la chat"

#: src/telegram_dialog.rs
msgid "Use Another Bot"
msgstr "Usa un altro bot"

#: src/telegram_dialog.rs
msgid "Say Hello"
msgstr "Saluta il bot"

#: src/telegram_dialog.rs
msgid "Disconnect"
msgstr "Scollega"

#. Translators: {} is the bot's username, such as @my_tasks_bot.
#: src/telegram_dialog.rs
msgid "Connected to @{}"
msgstr "Collegato a @{}"

#: src/telegram_dialog.rs
msgid "Disconnect From Telegram?"
msgstr "Scollegare Telegram?"

#: src/telegram_dialog.rs
msgid "Send them to a Telegram bot of your own"
msgstr "Mandali a un tuo bot Telegram"

#: src/telegram_dialog.rs
msgid "Open @BotFather"
msgstr "Apri @BotFather"

#: src/telegram_dialog.rs
msgid "Send it /newbot and pick a name"
msgstr "Mandagli /newbot e scegli un nome"

#. Translators: {} is the bot's username, such as @my_tasks_bot.
#: src/telegram_dialog.rs
msgid "Send any message to @{}"
msgstr "Manda un messaggio qualsiasi a @{}"

#: src/telegram_dialog.rs
msgid "Send it one task per line. They arrive while Now Do This is open."
msgstr "Mandagli un task per riga. Arrivano mentre Now Do This è aperta."

#: src/telegram_dialog.rs
msgid "Messages sent to the bot will no longer reach your list"
msgstr "I messaggi mandati al bot non arriveranno più alla tua lista"
