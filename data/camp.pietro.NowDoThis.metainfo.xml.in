<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>camp.pietro.NowDoThis</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Now Do This</name>
  <summary>Do today's tasks one by one</summary>
  <description>
    <p>
      Now Do This shows you a single task at a time, so you can get on with it
      instead of looking at a list.
    </p>
    <p>
      Write down what you are doing today, one task per line, and start. Each
      task fills the screen on its own until you mark it done, and the next one
      takes its place. There is no counter and no way to postpone.
    </p>
    <p>
      Something that comes up while you are working can be added without leaving
      the task at hand, and whatever you do not finish is still waiting tomorrow.
    </p>
  </description>

  <developer id="camp.pietro">
    <name>Pietro Campagnano</name>
  </developer>

  <url type="homepage">https://github.com/fain182/nowdothis</url>
  <url type="bugtracker">https://github.com/fain182/nowdothis/issues</url>
  <url type="vcs-browser">https://github.com/fain182/nowdothis</url>

  <translation type="gettext">nowdothis</translation>
  <launchable type="desktop-id">camp.pietro.NowDoThis.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#c7e9d0</color>
    <color type="primary" scheme_preference="dark">#1b3a2a</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/fain182/nowdothis/main/data/screenshots/doing.png</image>
      <caption>One task at a time, with nothing else on screen</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/fain182/nowdothis/main/data/screenshots/planning.png</image>
      <caption>The day written out, one task per line</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/fain182/nowdothis/main/data/screenshots/all-done.png</image>
      <caption>Nothing left to do</caption>
    </screenshot>
  </screenshots>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>

  <releases>
    <release version="0.1.0" date="2026-07-25">
      <description translate="no">
        <p>First release.</p>
      </description>
    </release>
  </releases>

</component>
